# Apex Wholesale - Environment Variables Example
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=

# Reddit API (script app credentials from https://www.reddit.com/prefs/apps)
# Required for leads to flow — Reddit blocks unauthenticated requests from Vercel's IPs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=your-reddit-username

# AI Configuration
GEMINI_API_KEY=your-google-ai-api-key

# App Configuration
PORT=3002
VITE_API_URL=http://localhost:3002
