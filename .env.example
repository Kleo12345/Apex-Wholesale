# Apex Wholesale - Environment Variables Example
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=

# Reddit API (script app credentials from https://www.reddit.com/prefs/apps)
# Optional — used if you have an existing app. Reddit is currently not issuing new
# app credentials to most accounts, so PROXY_URL below is the primary fix.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=your-reddit-username

# Proxy (required for leads to flow) — Reddit blocks unauthenticated requests from
# Vercel's datacenter IPs. Routing through a residential/rotating proxy sidesteps this.
# Format: http://username:password@proxy-host:port  (e.g. from Webshare, Bright Data, etc.)
PROXY_URL=

# AI Configuration
GEMINI_API_KEY=your-google-ai-api-key

# App Configuration
PORT=3002
VITE_API_URL=http://localhost:3002
